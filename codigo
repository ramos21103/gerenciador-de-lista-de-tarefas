def adicionar_tarefa(lista, tarefa):
    lista.append(tarefa)
    print(f"Sucesso '{tarefa}' foi adicionada.") 

def remover_tarefa(lista, tarefa):
    if tarefa in lista:
        lista.remove(tarefa)
        print(f"Sucesso '{tarefa}' foi removida.")
    else:
        print("Esse item não está na lista.") 
      
def exibir_lista(lista):
    print("\n--- SUAS TAREFAS ---")
    if lista == []: 
        print("Sua lista está vazia. Adicione algo primeiro.")
    else:
        for item in lista:
            print(f"- {item}")
    print("--------------------\n")

def limpar_tela():
    print("\n" * 50)

minha_lista = []

while True:
    limpar_tela()
    print("Bem vindo ao gerenciador do sistema de tarefas")
    print("Digite 1 para adicionar uma tarefa na lista")
    print("Digite 2 para remover uma tarefa da lista")
    print("Digite 3 para mostrar a lista")
    print("Digite 4 para sair do gerenciador")
    escolha = input("Digite de 1 a 4: ")

    if escolha == "1":
        nova = input("Digite um item para adicionar: ")
        adicionar_tarefa(minha_lista, nova)
        input("\nPressione ENTER para continuar...") 
        
    elif escolha == "2":
        remove = input("Digite um item para remover: ")
        remover_tarefa(minha_lista, remove)
        input("\nPressione ENTER para continuar...") 
        
    elif escolha == "3":
        limpar_tela() 
        exibir_lista(minha_lista) 
        input("Pressione ENTER para voltar ao menu...")
        
    elif escolha == "4":
        limpar_tela()
        print("Saindo do sistema. Até logo!")
        break
